<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.paopaoime.aikeyboard.midscene.overlay.MidsceneExecutionOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="midscene_execution_overlay" />
        </service>

        <provider
            android:name="com.paopaoime.aikeyboard.addon.automation.AutomationAddonInitializer"
            android:authorities="${applicationId}.oemaddon.automation"
            android:exported="false" />
    </application>

</manifest>
