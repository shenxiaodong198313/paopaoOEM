<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 白色边框 (White Border) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>

    <!-- 2. 阴影层 (Shadow) -->
    <!-- 稍微缩小一点，在白边内部 -->
    <!-- 内缩从2dp增加到4dp，实现白边加粗一倍 -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#40FF5F40"/> <!-- 半透明红色阴影 -->
        </shape>
    </item>

    <!-- 3. 主体颜色 (Base Color) -->
    <!-- 内缩从2dp增加到4dp，实现白边加粗一倍 -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#FF8C66"
                android:endColor="#FF5F40"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- 4. 顶部高光 (Top Specular Highlight) -->
    <!-- 相应调整内缩，保持相对位置 -->
    <item android:top="9dp" android:left="9dp" android:right="29dp" android:bottom="29dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:centerX="0.2"
                android:centerY="0.2"
                android:startColor="#CCFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- 5. 底部反光 (Bottom Rim Light) -->
    <!-- 相应调整内缩，保持相对位置 -->
    <item android:top="19dp" android:left="19dp" android:bottom="6dp" android:right="6dp">
         <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:centerX="0.8"
                android:centerY="0.8"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- 6. 细微的边缘发光 -->
    <!-- 内缩从2dp增加到4dp，实现白边加粗一倍 -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>
