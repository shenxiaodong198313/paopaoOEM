<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oem_settings_page_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_developer_ai_model_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_developer_ai_model_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_home_panel_top_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#2E3131" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:gravity="center"
            android:text="@string/developer_ai_model_config_title"
            android:textColor="#343837"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_developer_ai_model_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_developer_ai_model_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_developer_ai_model_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/card_developer_ai_model_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_layout_display_section_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/developer_ai_model_intro_title"
                    android:textColor="#2E3131"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_developer_ai_model_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/developer_ai_model_intro_desc"
                    android:textColor="#818785"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_developer_ai_model_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_layout_display_section_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/developer_ai_model_fields_title"
                    android:textColor="#2E3131"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_developer_ai_model_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#818785"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_developer_api_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_api_base_url_hint"
                    android:inputType="textUri"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_developer_ai_openai_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_openai_base_url_hint"
                    android:inputType="textUri"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_developer_ai_openai_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_openai_api_key_hint"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_developer_ai_openai_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_openai_model_hint"
                    android:inputType="text"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_developer_ai_temperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_temperature_hint"
                    android:inputType="numberDecimal"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_developer_ai_top_p"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_top_p_hint"
                    android:inputType="numberDecimal"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_developer_ai_max_tokens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/developer_ai_model_max_tokens_hint"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_developer_ai_model_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_layout_display_section_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/btn_developer_ai_model_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_developer_mode_chip_unselected"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="10dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="9dp"
                    android:text="@string/developer_ai_model_reset"
                    android:textColor="#2E3131"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_developer_ai_model_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_dark"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="10dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="9dp"
                    android:text="@string/developer_ai_model_save"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
