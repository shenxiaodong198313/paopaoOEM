<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_memory_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_memory_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#C4C4C6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_memory_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/memory_library_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#C4C4C6"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/btn_memory_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_memory_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_memory_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_memory_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_memory_stats"
        app:layout_constraintBottom_toTopOf="@id/btn_memory_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/et_memory_search"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_filter_chip_normal"
        android:hint="搜索 topic / 标签 / 内容"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#8F8F93"
        app:layout_constraintTop_toBottomOf="@id/layout_memory_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/sv_memory_source_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/et_memory_search"
        app:layout_constraintStart_toStartOf="@id/et_memory_search"
        app:layout_constraintEnd_toEndOf="@id/et_memory_search">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_memory_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="全部"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_filter_legacy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="68dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="历史记忆"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_filter_working"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="58dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="working"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_filter_short"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="short"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_filter_long"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="long"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/sv_memory_persona_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/sv_memory_source_filters"
        app:layout_constraintStart_toStartOf="@id/et_memory_search"
        app:layout_constraintEnd_toEndOf="@id/et_memory_search">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_memory_persona_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="全人设"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_persona_npc1"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="npc1"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_persona_npc2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="npc2"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_memory_persona_system"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:minWidth="58dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="system"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_memory_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="共 0 条"
        android:textColor="#8F8F93"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/sv_memory_persona_filters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_memory_add"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="@string/memory_add"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_generate_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
