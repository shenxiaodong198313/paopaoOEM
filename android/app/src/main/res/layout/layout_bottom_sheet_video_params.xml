<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="16dp">

    <!-- 标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="视频参数设置"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <ImageView
            android:id="@+id/btn_close_params"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu_close"
            android:layout_alignParentEnd="true"
            android:tint="#FFFFFF"/>
    </RelativeLayout>

    <!-- 时长 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="视频时长"
        android:textColor="#999999"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/btn_duration_5"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="5秒"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary_blue"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/btn_duration_10"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="10秒"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_secondary_gray"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 模式 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="生成模式"
        android:textColor="#999999"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/btn_mode_std"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="标准模式"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary_blue"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/btn_mode_pro"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="专家模式"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_secondary_gray"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 比例 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="视频比例"
        android:textColor="#999999"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">
        <TextView
            android:id="@+id/btn_ratio_16_9"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="16:9"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_option_selected_green"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/btn_ratio_9_16"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="9:16"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_option_normal_dark"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/btn_ratio_1_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1:1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_option_normal_dark"/>
    </LinearLayout>

    <!-- 确认按钮 -->
    <Button
        android:id="@+id/btn_generate_action"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="立即生成"
        android:textColor="#000000"
        android:backgroundTint="#4CAF50"
        android:textStyle="bold"/>

</LinearLayout>
