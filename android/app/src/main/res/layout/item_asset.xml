<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_asset_thumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:minHeight="150dp"
            android:src="@android:color/darker_gray" />

        <ImageView
            android:id="@+id/iv_play_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerInParent="true"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/bg_option_selected"
            android:padding="8dp"
            app:tint="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_asset_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/iv_asset_thumb"
            android:layout_alignEnd="@id/iv_asset_thumb"
            android:layout_margin="8dp"
            android:background="@drawable/bg_option_selected"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="IMG"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_asset_thumb"
            android:ellipsize="end"
            android:maxLines="2"
            android:padding="8dp"
            android:text="Prompt..."
            android:textColor="#666666"
            android:textSize="12sp" />
            
    </RelativeLayout>
</androidx.cardview.widget.CardView>
