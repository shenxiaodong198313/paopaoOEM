<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_meeting"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tv_meeting_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Homepage Redesign Review"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_more"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_meeting_options"
        app:tint="#888888"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_meeting_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Marketing Website Revamp"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_meeting_title" />

    <LinearLayout
        android:id="@+id/ll_datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_meeting_subtitle">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_meeting_calendar"
            app:tint="#888888" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12/02/2025"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_meeting_clock"
            app:tint="#888888" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00 AM"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Avatars Placeholder -->
    <LinearLayout
        android:id="@+id/ll_avatars"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/ll_datetime"
        app:layout_constraintTop_toTopOf="@id/ll_datetime">
        
        <!-- Just using circles for now as placeholders -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle_cyan"
            android:backgroundTint="#FF5722" />
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle_cyan"
            android:backgroundTint="#2196F3"
            android:layout_marginStart="-8dp" />
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle_cyan"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="-8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_join_now"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:text="立即执行"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:gravity="center"
        android:background="@drawable/bg_btn_gradient_border"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_datetime" />

</androidx.constraintlayout.widget.ConstraintLayout>
