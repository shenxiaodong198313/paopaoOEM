<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 顶部导航 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu_close"
            app:tint="#FFFFFF"
            android:layout_centerVertical="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_centerInParent="true"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频生成"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>
        
        <ImageView
            android:id="@+id/btn_my_assets"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_toStartOf="@id/btn_model_select"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#FFFFFF" />

        <LinearLayout
             android:id="@+id/btn_model_select"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_alignParentEnd="true"
             android:layout_centerVertical="true"
             android:background="@drawable/bg_card_dark_12dp"
             android:paddingHorizontal="8dp"
             android:paddingVertical="4dp"
             android:gravity="center_vertical">
             <ImageView
                 android:id="@+id/iv_current_model_icon"
                 android:layout_width="16dp"
                 android:layout_height="16dp"
                 android:layout_marginEnd="6dp"
                 android:src="@drawable/ic_model_creative_default" />
             <TextView
                 android:id="@+id/tv_current_model"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="kling-v2-1"
                 android:textColor="#FFFFFF"
                 android:textSize="12sp"/>
             <ImageView
                 android:layout_width="12dp"
                 android:layout_height="12dp"
                 android:src="@drawable/ic_menu_arrow_down"
                 app:tint="#FFFFFF"
                 android:layout_marginStart="4dp"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Tab 切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_container_dark"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tab_text2video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="文生视频"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_pill_tab_selected_gray" />

            <TextView
                android:id="@+id/tab_img2video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="图生视频"
                android:textSize="14sp"
                android:textColor="#999999" />
        </LinearLayout>
    </LinearLayout>

    <!-- 文生视频面板 -->
    <LinearLayout
        android:id="@+id/panel_text2video"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_dark_12dp"
            android:padding="16dp">
            
            <EditText
                android:id="@+id/et_prompt_text2video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="描述你想生成的视频内容。例如：一只可爱的小猫在草地上奔跑"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:gravity="top|start"
                android:textSize="14sp"/>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:orientation="horizontal">
                 <ImageView
                     android:layout_width="24dp"
                     android:layout_height="24dp"
                     android:src="@drawable/ic_menu_edit"
                     app:tint="#FFFFFF"
                     android:alpha="0.7"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 图生视频面板 -->
    <LinearLayout
        android:id="@+id/panel_img2video"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_card_dark_12dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            
            <EditText
                android:id="@+id/et_prompt_img2video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="描述视频内容（选填）"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:gravity="top|start"
                android:textSize="14sp"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/btn_add_start_frame"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_dark_12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu_plus"
                app:tint="#4CAF50"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传首帧 (必需)"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:layout_marginStart="8dp"/>
                
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            
            <ImageView
                android:id="@+id/iv_start_frame_preview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:visibility="gone"/>
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/btn_add_end_frame"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_dark_12dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu_plus"
                app:tint="#666666"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传尾帧 (可选，需专家模式)"
                android:textColor="#666666"
                android:textSize="16sp"
                android:layout_marginStart="8dp"/>
                
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            
            <ImageView
                android:id="@+id/iv_end_frame_preview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">
        
        <LinearLayout
            android:id="@+id/btn_params_summary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_dark_12dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="16dp">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_summary_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5秒"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_summary_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:9"
                        android:textColor="#999999"
                        android:textSize="10sp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/tv_summary_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标准模式"
                        android:textColor="#999999"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_arrow_down"
                app:tint="#FFFFFF"/>
        </LinearLayout>
        
        <Button
            android:id="@+id/btn_generate_main"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="生成视频"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_generate_gradient_green"
            app:backgroundTint="@null"
            android:textStyle="bold"/>
    </LinearLayout>

    </LinearLayout>

</RelativeLayout>
