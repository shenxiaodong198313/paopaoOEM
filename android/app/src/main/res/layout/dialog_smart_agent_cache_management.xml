<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="缓存管理"
            android:textColor="#1A2433"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="快捷指令当前优先使用 Qwen 原生缓存的稳定前缀命中。测试时如需避开旧缓存，可关闭缓存优化或清空当前缓存空间。"
            android:textColor="#627081"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_shortcut_cache_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="开启快捷指令缓存优化"
            android:textColor="#1A2433"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_shortcut_cache_namespace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#1A2433"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_shortcut_cache_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#627081"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_shortcut_cache_clear"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_home_panel_top_button"
            android:text="清空已有缓存"
            android:textAllCaps="false"
            android:textColor="#D74F4F"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_shortcut_cache_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="说明：当前“清空已有缓存”会切换到新的缓存空间，后续请求不再复用旧缓存。对于模型底层的隐式缓存对象，不执行物理删除。"
            android:textColor="#8D98A5"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
