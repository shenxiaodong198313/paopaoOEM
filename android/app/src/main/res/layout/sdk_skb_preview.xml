<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_alignParentEnd="true">
    <com.paopaoime.aikeyboard.ime.view.CandidatesBar
        android:id="@+id/candidates_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.paopaoime.aikeyboard.ime.keyboard.container.InputViewParent
        android:id="@+id/skb_input_keyboard_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/candidates_bar">
    </com.paopaoime.aikeyboard.ime.keyboard.container.InputViewParent>
</RelativeLayout>