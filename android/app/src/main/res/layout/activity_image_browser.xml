<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Toolbar -->
    <RelativeLayout
        android:id="@+id/layout_top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_download"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_download"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_share"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_menu_more_horiz"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Image Pager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_images"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_toolbar"
        android:layout_above="@id/recycler_thumbnails" />
        
    <!-- Page Indicator -->
    <TextView
        android:id="@+id/tv_page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/recycler_thumbnails"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_option_selected"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="1/4"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"/>

    <!-- Bottom Thumbnails -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_thumbnails"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:background="#1A1A1A" />

</RelativeLayout>