<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.wework" />
        <package android:name="com.whatsapp" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.smile.gifmaker" />
        <intent>
            <action android:name="org.fcitx.fcitx5.android.plugin.MANIFEST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name="com.paopaoime.aikeyboard.app.BaseApplication"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/paopao_app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppTheme"
        tools:replace="android:name,android:theme,android:icon,android:roundIcon,android:label">

        <meta-data
            android:name="roro.stellar.permissions"
            android:value="stellar" />

        <!--
            OEM 统一功能选择：除「基础 + 输入法核心」外，其余功能默认全部关闭；
            企业集成后按开通范围显式开启。本工程为企业全功能验证工程，显式声明全量开启。
        -->
        <meta-data
            android:name="com.paopaoime.oem.enableUi"
            android:value="true" />
        <meta-data
            android:name="com.paopaoime.oem.enableAi"
            android:value="true" />
        <meta-data
            android:name="com.paopaoime.oem.enableAiReply"
            android:value="true" />
        <!-- AI 回复「传图回复」最多可选图片数；未配置默认 5，有效范围 1..20 -->
        <meta-data
            android:name="com.paopaoime.oem.aiReplyMaxImageSelection"
            android:value="5" />
        <!-- AI 回复 / 素材库单次文本发送最大字符数；未配置默认 1000 -->
        <meta-data
            android:name="com.paopaoime.oem.sendTextMaxChars"
            android:value="1000" />
        <meta-data
            android:name="com.paopaoime.oem.enableQaSession"
            android:value="true" />
        <meta-data
            android:name="com.paopaoime.oem.enableMaterialLibrary"
            android:value="true" />
        <meta-data
            android:name="com.paopaoime.oem.enableAutomation"
            android:value="true" />
        <meta-data
            android:name="com.paopaoime.oem.enableAutomationSettingsEntry"
            android:value="false" />
        <meta-data
            android:name="com.paopaoime.oem.enable_developer"
            android:value="true" />

        <!-- 开发者入口开关：本工程为验证工程保持开启；正式交付宿主默认关闭 -->
        <meta-data
            android:name="com.paopaoime.oem.enable_developer_entry"
            android:value="true" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.OemMainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.CustomizeToolbarActivity"
            android:exported="false"
            android:theme="@style/Theme.AppTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.paopaoime.aikeyboard.action.OPEN_CUSTOMIZE_TOOLBAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.setup.SetupActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppTheme" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.FilePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.pickerbridge"
            android:theme="@style/Theme.AppTheme" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.ImagePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.pickerbridge"
            android:theme="@style/Theme.AppTheme" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.FavoriteAttachmentPreviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".materialhub"
            android:theme="@style/Theme.FavoriteAttachmentPreview" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.MyImagesActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.MyVideosActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.MyAssetsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.GenerationResultActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.ui.activity.ImageBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.paopaoime.aikeyboard.ime.libs.cropper.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.CropActivityTheme" />

        <provider
            android:name="com.paopaoime.aikeyboard.ime.libs.cropper.CropFileProvider"
            android:authorities="${applicationId}.cropper.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pp_cropper_library_file_paths" />
        </provider>

        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.AppTheme"
            tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppTheme"
            tools:replace="android:exported,android:theme">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.LogActivity"
            android:directBootAware="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName="org.fcitx.fcitx5.android.ui.main.MainActivity"
            android:theme="@style/Theme.AppTheme"
            tools:replace="android:theme" />

        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.settings.theme.CustomThemeActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="@string/edit_theme"
            android:theme="@style/Theme.AppTheme"
            tools:replace="android:theme" />

        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.AppTheme"
            tools:replace="android:theme" />

        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.ClipboardEditActivity"
            android:autoRemoveFromRecents="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:label="@string/edit_clipboard"
            android:launchMode="singleInstance"
            android:taskAffinity=".ui.main.ClipboardEditActivity"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />

        <service
            android:name="org.fcitx.fcitx5.android.input.FcitxInputMethodService"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </service>

        <service
            android:name="com.paopaoime.aikeyboard.ime.service.AiInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/paopao_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

    </application>

</manifest>
